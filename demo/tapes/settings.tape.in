# Generated per theme by demo/record.sh (@MODE@): shared by every tape.
Set Shell "bash"
Set FontFamily "Inconsolata"
Set FontSize 21
Set LineHeight 1.25
Set Width 1180
Set Height 640
Set Padding 30
Set Margin 0
Set WindowBar ""
Set Theme @THEME@
Set TypingSpeed 30ms
Set Framerate 30
Hide
Type "source @STATE@/shell.sh && export PS1='❯ ' && clear"
Enter
Sleep 300ms
Show
