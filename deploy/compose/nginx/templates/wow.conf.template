# The routes (docs/self-host/reverse-proxy.md). nginx's image replaces
# ${WOW_SITE_HOST} and ${WOW_FULL_HOST} from the environment at start; the
# other $ names are nginx's own.
#   WOW_SITE_HOST  the static sites for friends: files only, no login
#   WOW_FULL_HOST  your full view (its own login: BASIC_AUTH_USER) and the
#                  MCP endpoint for your AI (its own OAuth login)

server {
    listen 80;
    server_name ${WOW_SITE_HOST} ${WOW_FULL_HOST};
    return 301 https://$host$request_uri;
}

# Anything that names neither host: no answer.
server {
    listen 443 ssl default_server;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${WOW_SITE_HOST};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    location / {
        proxy_set_header Host $host;
        proxy_pass http://site:8080;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${WOW_FULL_HOST};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    # The shipper posts up to 8 MiB at a time to /ingest (nginx's default is 1 MiB).
    client_max_body_size 8m;

    # The MCP endpoint and its login, on port 8090. No page login in front:
    # the MCP's own tokens protect them, and cookies must pass on the login pages.
    location ~ ^/(mcp(/.*)?|authorize|token|register|revoke|consent|oauth/callback|\.well-known/oauth-authorization-server(/.*)?|\.well-known/oauth-protected-resource(/.*)?)$ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_pass http://ui:8090;
    }

    # The shipper's 3D files (wowstats/assets.py MAX_FILE): an HD character
    # model with its animations is 17-28 MB, and the server takes up to 48 MiB.
    # Only this route: everything else keeps the 8 MiB above.
    location ^~ /install/assets/ {
        client_max_body_size 48m;
        proxy_set_header Host $host;
        proxy_pass http://ui:8080;
    }

    # Everything else is the page on 8080, /ingest (the shipper) included.
    location / {
        proxy_set_header Host $host;
        proxy_pass http://ui:8080;
    }
}
