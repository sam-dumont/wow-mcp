# Copy to .env (same folder) and fill in. Keep it readable by you only:
#   chmod 600 .env

# The shipper's password for POST /ingest (user "wow"), 12+ characters.
# The same value goes in the shipper's config.toml, [ship] password.
INGEST_PASSWORD=

# Where the full view is published. The default keeps it on this computer.
# To reach it from your network (the shipper on another PC, your phone):
#   UI_PUBLISH=0.0.0.0:8080 and UI_AUTH=basic with a user and password below.
UI_PUBLISH=127.0.0.1:8080
UI_AUTH=open
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Names you reach the page by besides localhost and IP addresses (nas.local),
# comma separated: any other name is refused.
# UI_ALLOWED_HOSTS=nas.local

# The static sites for friends (the publish and site services): the public
# view at /, the full content at /zogzog/#<key>. SITE_URL is the address
# friends use, for the /zogzog/ link printed when the key is made.
SITE_PUBLISH=127.0.0.1:8081
SITE_URL=http://127.0.0.1:8081
# No site for friends with the link (only the public view): uncomment.
# Left out, it is /zogzog/. The link: docker compose run --rm publish zogzog-key link
# ZOGZOG_PATH=

# What the page and the publisher download: the 3D character (MODEL3D), and
# Wago's public game tables (WOW_ITEMS: item names, icons and cards, talent
# names, the knowledge base's spell and zone documents).
# The small preset, no downloads at all (offline, small machine, cold cache):
# MODEL3D=off
# WOW_ITEMS=off

# A ceiling for the events' disk (VictoriaLogs), e.g. 20GiB. Past it the
# OLDEST days are deleted for good: back up the vl-data volume first if you
# want them. Empty or 0: no ceiling (events are kept 100 years).
# VL_MAX_DISK=20GiB

# The ui's memory limit (default 1g). It peaked at 472 MiB on 55 weeks of the
# demo; raise it for a much longer history (docs/install.md, "Memory").
# UI_MEM_LIMIT=2g

# The old live public view (docker compose --profile public up -d).
PUBLIC_PUBLISH=127.0.0.1:8082

# Your timezone, for the hours and weekdays the analysis reads (IANA name).
# Empty: Europe/Brussels.
# WOW_TIMEZONE=America/New_York

# The character the page opens on (Name-Surname, as in your WTF folder).
# Empty: the one you played last.
DEFAULT_CHAR=

# Ask Claude about your character (docs/mcp.md). The MCP endpoint, for
# claude.ai or Claude Code: the URL they use, ending in /mcp, served on port
# 8090. claude.ai needs https from the internet (your reverse proxy). The
# login is your identity provider's: needs secrets/oidc_client_secret.
# MCP_PUBLIC_URL=https://wow.example.com/mcp
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_ALLOWED_SUBS=
# MCP_SIGNING_KEY_FILE=/run/wow-secrets/mcp_signing_key
# The spec each character's gear is scored for, when it isn't what its add-ons
# say (comma-separated Name-Surname:spec pairs):
# WEIGHTS=Name-Surname:shadow

# Battle.net exporter (docker compose --profile exporter up -d). Needs
# secrets/bnet_client_id, secrets/bnet_client_secret and secrets/vm_merge_key:
# see README, "Battle.net client". Then set VM_URL so the page reads it.
# VM_URL=http://victoriametrics:8428
BNET_REGION=eu
AH_FACTION=Alliance
# Items the exporter watches on the auction house: {"item id": "name"}.
WATCH_ITEMS={"2592":"Wool Cloth","4306":"Silk Cloth","4338":"Mageweave Cloth"}
# Your characters, as their WTF folders name them: the exporter reads their
# look (and level, equipment) from Battle.net once a day, for the 3D view.
# PROFILE_CHARACTERS=Name-Surname,Other-Name

# A released image instead of building this tree (docs/development.md,
# "Using a released image"; a private package needs docker login first):
# WOW_STATS_IMAGE=ghcr.io/<owner>/wow-mcp:<version>@sha256:<digest>

# Behind a reverse proxy (docs/self-host/reverse-proxy.md): the two names, and
# for Traefik the address Let's Encrypt writes to. The proxy files also need
# BASIC_AUTH_USER and BASIC_AUTH_PASSWORD above.
# WOW_SITE_HOST=wow.example.org
# WOW_FULL_HOST=wow-full.example.org
# ACME_EMAIL=you@example.org
